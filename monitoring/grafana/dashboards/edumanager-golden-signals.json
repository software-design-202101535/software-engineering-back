      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "container_memory_working_set_bytes{name=~\"edumanager-.+\"}", "legendFormat": "{{name}}" },
        { "refId": "B", "expr": "container_spec_memory_limit_bytes{name=~\"edumanager-.+\"}", "legendFormat": "{{name}} limit" }
